TOOLMUX_DATABASE_URL=postgres://toolmux:toolmux@127.0.0.1:5432/toolmux?sslmode=disable
TOOLMUX_MASTER_KEY=replace-with-base64-encoded-32-byte-key
TOOLMUX_BASE_URL=http://localhost:8080
# Native process listener. Compose listens on :8080 inside its container.
TOOLMUX_ADDR=127.0.0.1:8080
# Docker host interface and port; 0.0.0.0 explicitly exposes all IPv4 interfaces.
TOOLMUX_BIND_IP=127.0.0.1
TOOLMUX_PORT=8080
# Optional: used with compose.discovery.yaml for read-only agent discovery.
TOOLMUX_HOST_HOME=/path/to/your/home
