SENTINEL_DATABASE_URL=postgres://sentinel:sentinel@db:5432/sentinel?sslmode=disable
SENTINEL_MASTER_KEY=replace-with-base64-encoded-32-byte-key
SENTINEL_BASE_URL=http://localhost:8080
SENTINEL_ADDR=:8080
# Optional: used with compose.discovery.yaml for read-only agent discovery.
SENTINEL_HOST_HOME=/path/to/your/home
